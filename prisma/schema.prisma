// Prisma schema for Cane Corso Academy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  subscription  Subscription?
  enrollments   Enrollment[]
  progress      Progress[]
  referrals     Referral[]     @relation("Referrer")
  referredBy    Referral?      @relation("Referred")
  orders        Order[]
  videoSubmissions VideoSubmission[]
  cadSkillProgress UserCadSkillProgress[]

  role          Role      @default(MEMBER)
}

enum Role {
  MEMBER
  ADMIN
}

// Subscription Management
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier              SubscriptionTier
  status            SubscriptionStatus

  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  canceledAt        DateTime?

  // Founder pricing flag
  isFounderPricing  Boolean  @default(false)
}

enum SubscriptionTier {
  FOUNDATION  // $19/month
  MASTER      // $39/month
  ELITE       // $97/month
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

// Course Content
model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  slug        String   @unique
  thumbnail   String?
  order       Int      @default(0)

  tier        SubscriptionTier // Minimum tier required

  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  slug        String
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]

  @@unique([courseId, slug])
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title       String
  description String?
  slug        String
  order       Int      @default(0)

  videoUrl    String?
  duration    Int?     // in seconds
  content     String?  // Markdown content

  resources   Resource[]
  progress    Progress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([moduleId, slug])
}

model Resource {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title       String
  type        ResourceType
  url         String
  fileSize    Int?

  createdAt   DateTime @default(now())
}

enum ResourceType {
  PDF
  VIDEO
  DOCUMENT
  LINK
}

// User Progress Tracking
model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completed   Boolean  @default(false)
  completedAt DateTime?
  watchTime   Int      @default(0) // in seconds

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

// One-time Products
model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  slug        String   @unique

  price       Int      // in cents
  stripePriceId String?

  type        ProductType
  downloadUrl String?
  accessDays  Int?     // Access duration for courses

  thumbnail   String?
  published   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      OrderItem[]
}

enum ProductType {
  EBOOK
  COURSE
  BUNDLE
}

// Orders & Purchases
model Order {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  total           Int      // in cents
  status          OrderStatus

  stripePaymentId String?  @unique

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  price     Int      // in cents
  quantity  Int      @default(1)
}

// Referral System
model Referral {
  id          String   @id @default(cuid())

  referrerId  String
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  referredId  String   @unique
  referred    User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  rewardGiven Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Waitlist for pre-launch
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  concerns  String?  // Their biggest Cane Corso challenge

  source    String?  // Where they came from
  createdAt DateTime @default(now())

  converted Boolean  @default(false)
  convertedAt DateTime?
}

// Live Events & Q&A Sessions
model LiveEvent {
  id          String   @id @default(cuid())
  title       String
  description String

  scheduledAt DateTime
  duration    Int      // in minutes

  meetingUrl  String?
  recordingUrl String?

  tier        SubscriptionTier // Minimum tier required

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     LiveEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userEmail String
  userName  String?

  attended  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([eventId, userEmail])
}

// Cadskills NPC - Canine Achievement Degree Training System

model CadSkillCategory {
  id          String     @id @default(cuid())
  name        String     // e.g. "CAD-1: Foundation"
  level       Int        // 1, 2, 3
  description String
  order       Int        @default(0)

  skills      CadSkill[]
}

model CadSkill {
  id          String     @id @default(cuid())
  categoryId  String
  category    CadSkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String
  tips        String?    // Trainer tips from Coach Maximus
  order       Int        @default(0)

  userProgress UserCadSkillProgress[]
}

model UserCadSkillProgress {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     CadSkill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  status    CadSkillStatus  @default(NOT_STARTED)
  notes     String?

  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, skillId])
}

enum CadSkillStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Video Submissions for Master/Elite tiers
model VideoSubmission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  videoUrl    String

  feedback    String?
  feedbackBy  String?  // Admin/Trainer name
  feedbackAt  DateTime?

  status      SubmissionStatus @default(PENDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SubmissionStatus {
  PENDING
  REVIEWED
  ARCHIVED
}
